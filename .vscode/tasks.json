{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Create Zenn Book from Clipboard",
            "type": "shell",
            "command": "node",
            "args": [
                "-r",
                "dotenv/config",
                "${workspaceFolder}/src/index.js"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}